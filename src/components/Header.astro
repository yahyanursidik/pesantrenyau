---
import { Image } from 'astro:assets';
import logo from '../assets/logo-shield.png';
import Icon from './Icon.astro';
import { nav, site, WA_TANYA } from '../data/site';
---

<header class="hdr" data-header>
  <div class="container hdr__inner">
    <a href="#beranda" class="brand" aria-label="Beranda — Pesantren Gratis Abu Ubaidah bin Al Jarrah">
      <span class="brand__logo">
        <Image src={logo} alt="" width={44} densities={[1, 2]} loading="eager" />
      </span>
      <span class="brand__text">
        <span class="brand__name">Abu Ubaidah bin Al Jarrah</span>
        <span class="brand__sub">Pesantren Gratis Tahfidz Qur'an</span>
      </span>
    </a>

    <nav class="nav" aria-label="Navigasi utama">
      <ul>
        {
          nav.map((n) => (
            <li>
              <a href={n.href} data-spy={n.href.slice(1)}>
                {n.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="btn hdr__cta" href={site.daftarUrl} target="_blank" rel="noopener">
      Pendaftaran <Icon name="arrow" size={18} class="i-arrow" />
    </a>

    <button
      class="hdr__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="menu-mobile"
      data-menu-toggle
    >
      <span class="sr-only">Buka menu</span>
      <Icon name="menu" size={24} class="i-open" />
      <Icon name="x" size={24} class="i-close" />
    </button>
  </div>

  <div class="sheet" id="menu-mobile" hidden data-menu>
    <nav aria-label="Navigasi seluler" class="container">
      <ul>
        {
          nav.map((n, i) => (
            <li style={`--i:${i}`}>
              <a href={n.href} data-spy={n.href.slice(1)}>
                {n.label}
                <Icon name="arrow" size={20} />
              </a>
            </li>
          ))
        }
      </ul>
      <div class="sheet__cta">
        <a class="btn" href={site.daftarUrl} target="_blank" rel="noopener">
          {site.ctaLabel} <Icon name="arrow" size={18} class="i-arrow" />
        </a>
        <a class="btn btn--wa" href={WA_TANYA} target="_blank" rel="noopener">
          <Icon name="chat" size={18} /> Tanya via WhatsApp
        </a>
      </div>
    </nav>
  </div>
</header>

<style>
  .hdr {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    color: #fff;
    transition:
      background-color 0.3s ease,
      color 0.3s ease,
      box-shadow 0.3s ease;
  }

  .hdr.is-scrolled,
  .hdr.is-open {
    background: rgb(247 241 230 / 0.92);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    color: var(--ink);
    box-shadow: 0 1px 0 var(--line);
  }

  .hdr__inner {
    height: var(--header-h);
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    margin-right: auto;
    min-width: 0;
  }

  .brand__logo {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    flex: none;
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 0 0 1px rgb(19 33 63 / 0.08);
  }

  .brand__logo :global(img) {
    width: 40px;
    height: auto;
  }

  .brand__text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
    min-width: 0;
  }

  .brand__name {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    white-space: nowrap;
  }

  .brand__sub {
    font-size: 0.75rem;
    font-weight: 600;
    opacity: 0.72;
    white-space: nowrap;
  }

  .nav ul {
    display: flex;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav a {
    display: block;
    padding: 8px 14px;
    border-radius: 999px;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    opacity: 0.82;
    transition:
      opacity 0.2s,
      background-color 0.2s;
  }

  .nav a:hover {
    opacity: 1;
    background: rgb(255 255 255 / 0.1);
  }

  .is-scrolled .nav a:hover {
    background: rgb(19 33 63 / 0.06);
  }

  .nav a[aria-current='true'] {
    opacity: 1;
    background: rgb(233 162 59 / 0.2);
  }

  .hdr__cta {
    min-height: 44px;
    padding: 0 18px;
    font-size: 0.9375rem;
  }

  .hdr__toggle {
    display: none;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    border: 1px solid currentColor;
    border-color: rgb(255 255 255 / 0.3);
    background: transparent;
    cursor: pointer;
    place-items: center;
  }

  .is-scrolled .hdr__toggle,
  .is-open .hdr__toggle {
    border-color: var(--line-strong);
  }

  .hdr__toggle :global(.i-close) {
    display: none;
  }

  .is-open .hdr__toggle :global(.i-close) {
    display: block;
  }

  .is-open .hdr__toggle :global(.i-open) {
    display: none;
  }

  .sheet {
    height: calc(100dvh - var(--header-h));
    overflow-y: auto;
    background: var(--paper);
    border-top: 1px solid var(--line);
    padding-block: 12px 32px;
  }

  .sheet ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .sheet li {
    border-bottom: 1px solid var(--line);
    animation: slideIn 0.35s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: calc(var(--i) * 40ms);
  }

  .sheet li a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 2px;
    font-family: var(--font-display);
    font-size: 1.625rem;
    text-decoration: none;
  }

  .sheet li a[aria-current='true'] {
    color: var(--gold-deep);
  }

  .sheet__cta {
    display: grid;
    gap: 12px;
    margin-top: 28px;
  }

  @keyframes slideIn {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  @media (max-width: 1020px) {
    .nav,
    .hdr__cta {
      display: none;
    }
    .hdr__toggle {
      display: grid;
    }
  }

  @media (max-width: 380px) {
    .brand__sub {
      display: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
  const sheet = document.querySelector<HTMLElement>('[data-menu]')!;

  // Header berubah warna setelah melewati hero
  const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 24);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Menu seluler
  const setOpen = (open: boolean) => {
    toggle.setAttribute('aria-expanded', String(open));
    toggle.querySelector('.sr-only')!.textContent = open ? 'Tutup menu' : 'Buka menu';
    sheet.hidden = !open;
    header.classList.toggle('is-open', open);
    document.body.style.overflow = open ? 'hidden' : '';
  };
  toggle.addEventListener('click', () => setOpen(sheet.hidden));
  sheet.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !sheet.hidden) {
      setOpen(false);
      toggle.focus();
    }
  });
  matchMedia('(min-width: 1021px)').addEventListener('change', (e) => e.matches && setOpen(false));

  // Scroll-spy: tandai section yang sedang dibaca
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-spy]');
  const ids = [...new Set([...links].map((l) => l.dataset.spy!))];
  const sections = ids.map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];
  const spy = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        links.forEach((l) => l.setAttribute('aria-current', String(l.dataset.spy === e.target.id)));
      }
    },
    { rootMargin: '-45% 0px -50% 0px' }
  );
  sections.forEach((s) => spy.observe(s));
</script>
